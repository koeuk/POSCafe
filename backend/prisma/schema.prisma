generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum Role {
  admin
  cashier
}

enum OrderStatus {
  pending
  preparing
  ready
  completed
  cancelled
}

enum PaymentStatus {
  unpaid
  paid
  refunded
}

enum PaymentMethod {
  cash
  qr
  card
}

enum StockMode {
  count
  recipe
}

enum StockSource {
  recipe
  stock
}

model User {
  id                 Int                 @id @default(autoincrement())
  name               String              @db.VarChar(255)
  username           String              @unique(map: "UQ_users_username") @db.VarChar(255)
  email              String?             @unique(map: "UQ_users_email") @db.VarChar(255)
  password           String              @db.VarChar(255)
  avatar             String?             @db.VarChar(500)
  role               Role                @default(cashier)
  allowedPages       Json?
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now()) @db.DateTime(6)
  updatedAt          DateTime            @default(now()) @updatedAt @db.DateTime(6)
  orders             Order[]
  passwordResets     PasswordReset[]
  stockMovements     StockMovement[]
  inventoryMovements InventoryMovement[]
  refundedPayments   Payment[]

  @@index([role, isActive], map: "IDX_users_role_isActive")
  @@map("users")
}

model Category {
  id          Int       @id @default(autoincrement())
  name        String    @unique(map: "UQ_categories_name") @db.VarChar(255)
  description String?   @db.Text
  image       String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now()) @db.DateTime(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.DateTime(6)
  products    Product[]

  @@index([isActive], map: "IDX_categories_isActive")
  @@map("categories")
}

model Size {
  id        Int      @id @default(autoincrement())
  name      String   @unique(map: "UQ_sizes_name") @db.VarChar(50)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.DateTime(6)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(6)

  @@index([sortOrder], map: "IDX_sizes_sortOrder")
  @@map("sizes")
}

model AppSetting {
  id                 Int      @id
  appName            String   @default("POSCAFE") @db.VarChar(100)
  logoUrl            String?  @db.Text
  khrPerUsd          Int      @default(4100)
  bakongAccountId    String?  @db.VarChar(64)
  bakongMerchantName String?  @db.VarChar(25)
  bakongMerchantCity String?  @db.VarChar(15)
  khqrDynamic        Boolean  @default(true)
  createdAt          DateTime @default(now()) @db.DateTime(6)
  updatedAt          DateTime @default(now()) @updatedAt @db.DateTime(6)

  @@map("app_settings")
}

model Product {
  id              Int              @id @default(autoincrement())
  categoryId      Int?
  name            String           @db.VarChar(255)
  description     String?          @db.Text
  price           Decimal          @db.Decimal(10, 2)
  discountPercent Int              @default(0)
  image           String?          @db.VarChar(500)
  gallery         Json?
  stockMode       StockMode        @default(count)
  stock           Int              @default(0)
  isAvailable     Boolean          @default(true)
  archivedAt      DateTime?        @db.DateTime(6)
  createdAt       DateTime         @default(now()) @db.DateTime(6)
  updatedAt       DateTime         @default(now()) @updatedAt @db.DateTime(6)
  category        Category?        @relation(fields: [categoryId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_products_categoryId")
  variants        ProductVariant[]
  orderItems      OrderItem[]
  stockMovements  StockMovement[]
  recipes         Recipe[]

  @@index([name], map: "IDX_products_name")
  @@index([archivedAt, isAvailable], map: "IDX_products_archivedAt_isAvailable")
  @@index([categoryId, archivedAt, isAvailable], map: "IDX_products_categoryId_archivedAt_isAvailable")
  @@map("products")
}

model ProductVariant {
  id        Int      @id @default(autoincrement())
  productId Int
  size      String   @db.VarChar(50)
  price     Decimal  @default(0) @db.Decimal(10, 2)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now()) @db.DateTime(6)
  updatedAt DateTime @default(now()) @updatedAt @db.DateTime(6)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_product_variants_productId")

  @@unique([productId, size], map: "UQ_product_variants_productId_size")
  @@map("product_variants")
}

model StockMovement {
  id         Int      @id @default(autoincrement())
  productId  Int
  userId     Int?
  delta      Int
  stockAfter Int
  createdAt  DateTime @default(now()) @db.DateTime(6)
  updatedAt  DateTime @default(now()) @updatedAt @db.DateTime(6)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_stock_movements_productId")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_stock_movements_userId")

  @@index([productId, createdAt], map: "IDX_stock_movements_productId_createdAt")
  @@index([userId], map: "FK_stock_movements_userId")
  @@map("stock_movements")
}

model Order {
  id                 Int                 @id @default(autoincrement())
  userId             Int
  orderNumber        String              @unique(map: "UQ_orders_orderNumber") @db.VarChar(64)
  total              Decimal             @db.Decimal(10, 2)
  status             OrderStatus         @default(pending)
  paymentStatus      PaymentStatus       @default(unpaid)
  createdAt          DateTime            @default(now()) @db.DateTime(6)
  updatedAt          DateTime            @default(now()) @updatedAt @db.DateTime(6)
  user               User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_orders_userId")
  items              OrderItem[]
  payment            Payment?
  inventoryMovements InventoryMovement[]

  @@index([createdAt], map: "IDX_orders_createdAt")
  @@index([paymentStatus, createdAt], map: "IDX_orders_paymentStatus_createdAt")
  @@index([status, createdAt], map: "IDX_orders_status_createdAt")
  @@index([userId, createdAt], map: "IDX_orders_userId_createdAt")
  @@map("orders")
}

model OrderItem {
  id          Int         @id @default(autoincrement())
  orderId     Int
  productId   Int
  size        String?     @db.VarChar(50)
  quantity    Int
  unitPrice   Decimal     @db.Decimal(10, 2)
  subtotal    Decimal     @db.Decimal(10, 2)
  note        String?     @db.VarChar(255)
  extras      Json?
  stockSource StockSource @default(stock)
  createdAt   DateTime    @default(now()) @db.DateTime(6)
  updatedAt   DateTime    @default(now()) @updatedAt @db.DateTime(6)
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_order_items_orderId")
  product     Product     @relation(fields: [productId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "FK_order_items_productId")

  @@index([orderId], map: "FK_order_items_orderId")
  @@index([productId], map: "FK_order_items_productId")
  @@map("order_items")
}

model Payment {
  id           Int           @id @default(autoincrement())
  orderId      Int           @unique(map: "UQ_payments_orderId")
  refundedById Int?
  method       PaymentMethod
  amount       Decimal       @db.Decimal(10, 2)
  tendered     Decimal       @db.Decimal(10, 2)
  change       Decimal       @db.Decimal(10, 2)
  refundedAt   DateTime?     @db.DateTime(6)
  createdAt    DateTime      @default(now()) @db.DateTime(6)
  updatedAt    DateTime      @default(now()) @updatedAt @db.DateTime(6)
  order        Order         @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_payments_orderId")
  refundedBy   User?         @relation(fields: [refundedById], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_payments_refundedById")

  @@index([createdAt], map: "IDX_payments_createdAt")
  @@index([refundedAt], map: "IDX_payments_refundedAt")
  @@index([refundedById], map: "FK_payments_refundedById")
  @@map("payments")
}

model PasswordReset {
  id          Int       @id @default(autoincrement())
  userId      Int
  codeHash    String    @db.VarChar(255)
  attempts    Int       @default(0)
  expiresAt   DateTime  @db.DateTime(6)
  consumedAt  DateTime? @db.DateTime(6)
  completedAt DateTime? @db.DateTime(6)
  createdAt   DateTime  @default(now()) @db.DateTime(6)
  updatedAt   DateTime  @default(now()) @updatedAt @db.DateTime(6)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_password_resets_userId")

  @@index([userId, createdAt], map: "IDX_password_resets_userId_createdAt")
  @@index([createdAt], map: "IDX_password_resets_createdAt")
  @@map("password_resets")
}

model InventoryItem {
  id            Int                 @id @default(autoincrement())
  name          String              @db.VarChar(255)
  category      String              @default("Packaging") @db.VarChar(100)
  unit          String              @default("pcs") @db.VarChar(50)
  stockQuantity Decimal             @default(0) @db.Decimal(12, 3)
  minThreshold  Decimal             @default(0) @db.Decimal(12, 3)
  costPerUnit   Decimal             @default(0) @db.Decimal(10, 4)
  createdAt     DateTime            @default(now()) @db.DateTime(6)
  updatedAt     DateTime            @default(now()) @updatedAt @db.DateTime(6)
  movements     InventoryMovement[]
  recipeItems   RecipeItem[]

  @@index([category, name], map: "IDX_inventory_items_category_name")
  @@map("inventory_items")
}

model InventoryMovement {
  id              Int           @id @default(autoincrement())
  inventoryItemId Int
  orderId         Int?
  userId          Int?
  delta           Decimal       @db.Decimal(12, 3)
  stockAfter      Decimal       @db.Decimal(12, 3)
  reason          String        @default("restock") @db.VarChar(100)
  createdAt       DateTime      @default(now()) @db.DateTime(6)
  updatedAt       DateTime      @default(now()) @updatedAt @db.DateTime(6)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_inventory_movements_inventoryItemId")
  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_inventory_movements_orderId")
  user            User?         @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: NoAction, map: "FK_inventory_movements_userId")

  @@index([inventoryItemId, createdAt], map: "IDX_inventory_movements_inventoryItemId_createdAt")
  @@index([orderId, reason], map: "IDX_inventory_movements_orderId_reason")
  @@index([userId], map: "FK_inventory_movements_userId")
  @@map("inventory_movements")
}

model Recipe {
  id        Int          @id @default(autoincrement())
  productId Int
  size      String?      @db.VarChar(50)
  createdAt DateTime     @default(now()) @db.DateTime(6)
  updatedAt DateTime     @default(now()) @updatedAt @db.DateTime(6)
  product   Product      @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_recipes_productId")
  items     RecipeItem[]

  @@unique([productId, size], map: "UQ_recipes_productId_size")
  @@map("recipes")
}

model RecipeItem {
  id              Int           @id @default(autoincrement())
  recipeId        Int
  inventoryItemId Int
  quantity        Decimal       @db.Decimal(12, 3)
  unit            String?       @db.VarChar(50)
  optional        Boolean       @default(false)
  createdAt       DateTime      @default(now()) @db.DateTime(6)
  updatedAt       DateTime      @default(now()) @updatedAt @db.DateTime(6)
  recipe          Recipe        @relation(fields: [recipeId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_recipe_items_recipeId")
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "FK_recipe_items_inventoryItemId")

  @@unique([recipeId, inventoryItemId], map: "UQ_recipe_items_recipeId_inventoryItemId")
  @@index([inventoryItemId], map: "FK_recipe_items_inventoryItemId")
  @@map("recipe_items")
}
